// Sharebuild ERP — Prisma Schema
// Multi-tenant SaaS: Company → Project → Phase → Buyers/Expenses
// Derived from Relax Tower Excel workbook analysis

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN // SaaS platform owner
  COMPANY_ADMIN // Owner/MD of a construction company
  MANAGEMENT
  ACCOUNTS
  COLLECTION_OFFICER
  ENGINEER
  SITE_SUPERVISOR
  DOCUMENT_OFFICER
  AUDITOR
  MANAGER // Project manager
  ACCOUNTANT // Finance/accounts staff
  SITE_ENGINEER // Can log expenses, progress
  VIEWER // Read-only access
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum PhaseType {
  PILING
  BASEMENT
  SLAB // General floor slab (1st, 2nd, ... 10th)
  HALF_SLAB
  GATHUNI // Finishing work per floor (Gatoni/Gathuni)
  SANITARY
  FINISHING
  CUSTOM
}

enum PhaseStatus {
  DRAFT
  ACTIVE
  APPROVED
  INCLUDED_IN_SUMMARY
  EXCLUDED_FROM_SUMMARY
  CANCELLED
  DUPLICATE
}

enum UnitType {
  FLAT
  COMMERCIAL
  SHOP
  PARKING
  COMMON
  UTILITY
  ROOF
  LAND_SHARE
}

enum UnitStatus {
  AVAILABLE
  BOOKED
  SOLD
  REGISTERED
  HANDED_OVER
  DISPUTED
}

enum BuyerStatus {
  PROSPECT
  ACTIVE
  DEFAULTER
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CHEQUE
  BANK_TRANSFER
  MOBILE_BANKING // bKash, Nagad, etc.
  OTHER
}

enum TransactionType {
  COLLECTION // Money received from buyer
  REFUND // Refund to buyer
  ADJUSTMENT // Manual correction
}

enum ExpenseCategory {
  ROD_STEEL
  CEMENT
  STONE_AGGREGATE
  SAND
  BRICK
  READYMIX_CONCRETE
  TIMBER_SHUTTERING
  PAINT
  TILES
  SANITARY_FITTINGS
  ELECTRICAL_MATERIAL
  HARDWARE
  CHEMICAL
  LABOUR_BILL
  CONTRACTOR_BILL
  SECURITY_SALARY
  SITE_STAFF_SALARY
  WATER_BILL
  ELECTRICITY_BILL
  SITE_FOOD_HOSPITALITY
  TRANSPORT
  EQUIPMENT_HIRE
  SURVEY_DRAWING
  LEGAL_REGISTRATION
  MUNICIPALITY_FEE
  BANK_CHARGE
  SERVICE_CHARGE
  OTHER
}

enum ExpenseStatus {
  PENDING_APPROVAL
  APPROVED
  PAID
  PARTIALLY_PAID
  DISPUTED
  CANCELLED
}

enum SupplierType {
  MATERIAL_SUPPLIER
  LABOUR_CONTRACTOR
  EQUIPMENT_SUPPLIER
  SERVICE_PROVIDER
  CONSULTANT
}

enum PayableStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  DISPUTED
  WRITTEN_OFF
}

enum DemandStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  FULLY_PAID
  OVERDUE
  CANCELLED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  LOGIN
  LOGOUT
}

enum DocumentScope {
  PROJECT
  BUYER
  UNIT
  PHASE
  EXPENSE
  SUPPLIER_BILL
  SUBCONTRACTOR_BILL
  AUDIT
}

enum DocumentStatus {
  DRAFT
  VERIFIED
  REJECTED
}

enum ProjectVendorStatus {
  ACTIVE
  INACTIVE
  COMPLETED
  CANCELLED
}

enum CashBankAccountType {
  CASH
  BANK
  MOBILE_BANKING
  CHEQUE_CLEARING
  OTHER
}

enum MobileBankingProvider {
  BKASH
  NAGAD
  ROCKET
  OTHER
}

enum CashBankTransactionType {
  INFLOW
  OUTFLOW
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
}

enum CashBankSourceType {
  BUYER_COLLECTION
  DIRECT_EXPENSE
  SUPPLIER_PAYMENT
  SUBCONTRACTOR_PAYMENT
  ACCOUNT_TRANSFER
  OPENING_BALANCE
  ADJUSTMENT
  OTHER
}

enum CashBankTransactionStatus {
  DRAFT
  POSTED
  REVERSED
  CANCELLED
}

enum CashBankPartyType {
  BUYER
  SUPPLIER
  SUBCONTRACTOR
  LOCAL_SHOP
  COMPANY
  OTHER
}

enum ChequeType {
  ISSUED
  RECEIVED
}

enum ChequeStatus {
  PENDING
  CLEARED
  BOUNCED
  CANCELLED
  REPLACED
}

enum AccountTransferStatus {
  POSTED
  REVERSED
  CANCELLED
}

enum RetentionType {
  NONE
  FIXED
  PERCENTAGE
}

enum RetentionStatus {
  NOT_APPLICABLE
  HELD
  PARTIALLY_RELEASED
  RELEASED
  FORFEITED
}

enum ServiceChargeBasis {
  PROJECT_DEFAULT
  PHASE_TOTAL_COST
  DIRECT_EXPENSE
  SUPPLIER_BILLS
  SUBCONTRACTOR_BILLS
  MANUAL
}

// ─────────────────────────────────────────────
// TENANT: COMPANY
// ─────────────────────────────────────────────

model Company {
  id             String   @id @default(cuid())
  name           String
  nameBn         String? // Bangla name
  registrationNo String?
  address        String?
  addressBn      String?
  phone          String?
  email          String?
  logoUrl        String?
  website        String?
  taxId          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  users                 User[]
  projects              Project[]
  suppliers             Supplier[]
  projectSuppliers      ProjectSupplier[]
  projectSubcontractors ProjectSubcontractor[]
  buyers                Buyer[]
  settings              CompanySetting[]
  cashBankAccounts      CashBankAccount[]
  cashBankTransactions  CashBankTransaction[]
  chequeLogs            ChequeLog[]
  accountTransfers      AccountTransfer[]

  @@map("companies")
}

model CompanySetting {
  id        String   @id @default(cuid())
  companyId String
  key       String
  value     String
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, key])
  @@map("company_settings")
}

// ─────────────────────────────────────────────
// USERS & AUTH
// ─────────────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  companyId    String?
  name         String
  nameBn       String?
  email        String    @unique
  phone        String?
  passwordHash String
  role         UserRole  @default(VIEWER)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company                      Company?                 @relation(fields: [companyId], references: [id])
  projectAccess                ProjectUserAccess[]
  auditLogs                    AuditLog[]
  approvals                    Approval[]
  createdExpenses              Expense[]                @relation("ExpenseCreatedBy")
  approvedExpenses             Expense[]                @relation("ExpenseApprovedBy")
  staffAssignments             ProjectStaffAssignment[]
  uploadedDocuments            Document[]               @relation("DocumentUploadedBy")
  createdCashBankTransactions  CashBankTransaction[]    @relation("CashBankTransactionCreatedBy")
  reversedCashBankTransactions CashBankTransaction[]    @relation("CashBankTransactionReversedBy")
  createdAccountTransfers      AccountTransfer[]        @relation("AccountTransferCreatedBy")

  @@map("users")
}

model ProjectUserAccess {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  role      UserRole
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@map("project_user_access")
}

// ─────────────────────────────────────────────
// PROJECT & LAND
// ─────────────────────────────────────────────

model Project {
  id                      String        @id @default(cuid())
  companyId               String
  name                    String
  nameBn                  String?
  code                    String? // e.g. RT-2023
  address                 String?
  addressBn               String? // Unicode Bangla address
  area                    String? // e.g. Kawlar, Dakkhinkhan
  city                    String?       @default("Dhaka")
  postCode                String?
  phone                   String? // e.g. 01712553110
  landSize                String?
  totalFloors             Int?
  residentialFloors       Int?
  unitsPerFloor           Int?
  totalPlannedUnits       Int?
  parkingUtilityNote      String?
  defaultServiceChargePct Decimal?      @default(0)
  notes                   String?
  status                  ProjectStatus @default(ACTIVE)
  startDate               DateTime?
  expectedEndDate         DateTime?
  actualEndDate           DateTime?
  description             String?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  company               Company                  @relation(fields: [companyId], references: [id])
  lands                 Land[]
  units                 Unit[]
  phases                Phase[]
  buyers                ProjectBuyer[]
  userAccess            ProjectUserAccess[]
  documents             Document[]
  auditLogs             AuditLog[]
  supplierPayables      SupplierPayable[]
  projectSuppliers      ProjectSupplier[]
  projectSubcontractors ProjectSubcontractor[]
  staffAssignments      ProjectStaffAssignment[]
  cashBankTransactions  CashBankTransaction[]
  chequeLogs            ChequeLog[]

  @@map("projects")
}

model Land {
  id               String      @id @default(cuid())
  projectId        String
  plotNo           String?
  mouza            String?
  khatian          String?
  dag              String?
  totalArea        Decimal? // in decimal/katha/sqft
  areaUnit         String?     @default("katha")
  ownerShares      LandShare[]
  purchasePrice    Decimal?
  registrationDate DateTime?
  registrationCost Decimal?
  notes            String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  project Project @relation(fields: [projectId], references: [id])

  @@map("lands")
}

model LandShare {
  id           String   @id @default(cuid())
  landId       String
  buyerId      String
  sharePercent Decimal
  shareArea    Decimal?
  salePrice    Decimal?
  notes        String?

  land  Land  @relation(fields: [landId], references: [id])
  buyer Buyer @relation(fields: [buyerId], references: [id])

  @@map("land_shares")
}

// ─────────────────────────────────────────────
// UNITS / FLATS
// ─────────────────────────────────────────────

model Unit {
  id              String     @id @default(cuid())
  projectId       String
  floor           Int?
  unitNo          String // e.g. A1, B2, 3rd Floor East
  unitType        UnitType   @default(FLAT)
  status          UnitStatus @default(AVAILABLE)
  sizesqft        Decimal?
  facing          String? // North, South, East, West
  agreedPrice     Decimal? // Total sale price
  registrationFee Decimal?
  utilityCharge   Decimal?
  notes           String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  project          Project     @relation(fields: [projectId], references: [id])
  buyerAllocations UnitBuyer[]
  demands          Demand[]
  documents        Document[]

  @@map("units")
}

model UnitBuyer {
  id           String   @id @default(cuid())
  unitId       String
  buyerId      String
  sharePercent Decimal  @default(100)
  isPrimary    Boolean  @default(true)
  isPayer      Boolean  @default(true)
  relationship String?  @default("OWNER")
  notes        String?
  assignedAt   DateTime @default(now())

  unit  Unit  @relation(fields: [unitId], references: [id])
  buyer Buyer @relation(fields: [buyerId], references: [id])

  @@unique([unitId, buyerId])
  @@map("unit_buyers")
}

// ─────────────────────────────────────────────
// BUYERS / CONTACTS
// ─────────────────────────────────────────────

model Buyer {
  id         String      @id @default(cuid())
  companyId  String
  name       String
  nameBn     String?
  fatherName String?
  phone      String?
  phone2     String?
  email      String?
  nidNo      String?
  address    String?
  addressBn  String?
  status     BuyerStatus @default(ACTIVE)
  notes      String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  company         Company        @relation(fields: [companyId], references: [id])
  projectLinks    ProjectBuyer[]
  unitAllocations UnitBuyer[]
  landShares      LandShare[]
  collections     Collection[]
  demands         Demand[]
  documents       Document[]

  @@map("buyers")
}

model ProjectBuyer {
  id        String   @id @default(cuid())
  projectId String
  buyerId   String
  joinedAt  DateTime @default(now())
  notes     String?

  project Project @relation(fields: [projectId], references: [id])
  buyer   Buyer   @relation(fields: [buyerId], references: [id])

  @@unique([projectId, buyerId])
  @@map("project_buyers")
}

// ─────────────────────────────────────────────
// DEMAND NOTICES
// ─────────────────────────────────────────────

model Demand {
  id        String       @id @default(cuid())
  unitId    String
  buyerId   String
  phaseId   String?
  demandNo  String? // e.g. DN-2024-001
  title     String
  titleBn   String?
  amount    Decimal
  dueDate   DateTime?
  status    DemandStatus @default(DRAFT)
  issuedAt  DateTime?
  notes     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  unit        Unit                   @relation(fields: [unitId], references: [id])
  buyer       Buyer                  @relation(fields: [buyerId], references: [id])
  phase       Phase?                 @relation(fields: [phaseId], references: [id])
  collections Collection[]
  allocations CollectionAllocation[]

  @@map("demands")
}

// ─────────────────────────────────────────────
// PHASES (Construction Stages)
// ─────────────────────────────────────────────

model Phase {
  id               String      @id @default(cuid())
  projectId        String
  name             String // e.g. "Piling", "Basement", "1st Floor Slab"
  nameBn           String?
  phaseType        PhaseType   @default(SLAB)
  floorNo          Int? // for slab/gathuni phases
  status           PhaseStatus @default(DRAFT)
  sequence         Int         @default(0) // ordering
  workDesc         String?
  workDescBn       String?
  startDate        DateTime?
  endDate          DateTime?
  serviceChargePct Decimal?    @default(0) // e.g. 5%
  notes            String?
  auditLockedAt    DateTime?
  auditLockedById  String?
  auditLockReason  String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  project               Project                @relation(fields: [projectId], references: [id])
  collections           Collection[]
  expenses              Expense[]
  demands               Demand[]
  materialItems         MaterialItem[]
  approvals             Approval[]
  supplierPayables      SupplierPayable[]
  projectSubcontractors ProjectSubcontractor[]
  documents             Document[]

  @@map("phases")
}

// ─────────────────────────────────────────────
// COLLECTIONS (Income from Buyers)
// ─────────────────────────────────────────────

model Collection {
  id                 String          @id @default(cuid())
  phaseId            String
  buyerId            String
  demandId           String?
  accountId          String?
  receiptNo          String? // e.g. RCP-2024-001
  amount             Decimal
  paymentMethod      PaymentMethod   @default(CASH)
  transactionType    TransactionType @default(COLLECTION)
  chequeNo           String?
  chequeDate         DateTime?
  bankName           String?
  chequeBranchName   String?
  chequeMaturityDate DateTime?
  reference          String?
  receivedDate       DateTime        @default(now())
  notes              String?
  status             String          @default("APPROVED")
  reversedAt         DateTime?
  reversedById       String?
  reversalReason     String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  phase       Phase                  @relation(fields: [phaseId], references: [id])
  buyer       Buyer                  @relation(fields: [buyerId], references: [id])
  demand      Demand?                @relation(fields: [demandId], references: [id])
  account     CashBankAccount?       @relation(fields: [accountId], references: [id])
  allocations CollectionAllocation[]

  @@map("collections")
}

model CollectionAllocation {
  id           String   @id @default(cuid())
  collectionId String
  demandId     String
  amount       Decimal
  createdAt    DateTime @default(now())

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  demand     Demand     @relation(fields: [demandId], references: [id], onDelete: Cascade)

  @@index([collectionId])
  @@index([demandId])
  @@map("collection_allocations")
}

// ─────────────────────────────────────────────
// EXPENSES
// ─────────────────────────────────────────────

model Expense {
  id                 String          @id @default(cuid())
  phaseId            String
  supplierId         String?
  accountId          String?
  category           ExpenseCategory
  description        String
  descriptionBn      String?
  amount             Decimal
  paymentMethod      PaymentMethod   @default(CASH)
  supplierMode       String?         @default("NO_SUPPLIER")
  localShopName      String?
  localShopPhone     String?
  quantity           Decimal?
  unit               String? // kg, bags, cft, trucks, etc.
  unitPrice          Decimal?
  status             ExpenseStatus   @default(PENDING_APPROVAL)
  expenseDate        DateTime        @default(now())
  billNo             String?
  referenceNo        String?
  chequeNo           String?
  chequeDate         DateTime?
  chequeBankName     String?
  chequeBranchName   String?
  chequeMaturityDate DateTime?
  payableId          String?
  createdById        String
  approvedById       String?
  approvedAt         DateTime?
  notes              String?
  reversedAt         DateTime?
  reversedById       String?
  reversalReason     String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  phase      Phase            @relation(fields: [phaseId], references: [id])
  supplier   Supplier?        @relation(fields: [supplierId], references: [id])
  account    CashBankAccount? @relation(fields: [accountId], references: [id])
  createdBy  User             @relation("ExpenseCreatedBy", fields: [createdById], references: [id])
  approvedBy User?            @relation("ExpenseApprovedBy", fields: [approvedById], references: [id])
  payable    SupplierPayable? @relation(fields: [payableId], references: [id])
  documents  Document[]

  @@map("expenses")
}

// ─────────────────────────────────────────────
// MATERIAL PURCHASE (grouped purchase bills)
// ─────────────────────────────────────────────

model MaterialItem {
  id            String          @id @default(cuid())
  phaseId       String
  supplierId    String?
  category      ExpenseCategory
  description   String
  descriptionBn String?
  quantity      Decimal
  unit          String // kg, bag, cft, pcs, truck, etc.
  unitPrice     Decimal
  totalAmount   Decimal
  purchaseDate  DateTime        @default(now())
  billNo        String?
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  phase    Phase     @relation(fields: [phaseId], references: [id])
  supplier Supplier? @relation(fields: [supplierId], references: [id])

  @@map("material_items")
}

// ─────────────────────────────────────────────
// SUPPLIERS
// ─────────────────────────────────────────────

model Supplier {
  id            String       @id @default(cuid())
  companyId     String
  name          String
  nameBn        String?
  supplierType  SupplierType @default(MATERIAL_SUPPLIER)
  phone         String?
  email         String?
  address       String?
  contactPerson String?
  bankName      String?
  bankAccount   String?
  notes         String?
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  company               Company                @relation(fields: [companyId], references: [id])
  expenses              Expense[]
  materials             MaterialItem[]
  payables              SupplierPayable[]
  projectSuppliers      ProjectSupplier[]
  projectSubcontractors ProjectSubcontractor[]

  @@map("suppliers")
}

// ─────────────────────────────────────────────
// SUPPLIER PAYABLES
// ─────────────────────────────────────────────

model ProjectSupplier {
  id               String              @id @default(cuid())
  companyId        String
  projectId        String
  supplierId       String
  materialCategory String?
  phaseNotes       String?
  paymentTerms     String?
  creditDays       Int?
  openingBalance   Decimal             @default(0)
  contractNo       String?
  contractDate     DateTime?
  startDate        DateTime?
  endDate          DateTime?
  status           ProjectVendorStatus @default(ACTIVE)
  notes            String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  company   Company           @relation(fields: [companyId], references: [id])
  project   Project           @relation(fields: [projectId], references: [id])
  supplier  Supplier          @relation(fields: [supplierId], references: [id])
  documents Document[]
  payables  SupplierPayable[]

  @@unique([projectId, supplierId])
  @@index([companyId, projectId, status])
  @@map("project_suppliers")
}

model ProjectSubcontractor {
  id              String              @id @default(cuid())
  companyId       String
  projectId       String
  supplierId      String
  workType        String
  assignedPhaseId String?
  contractAmount  Decimal?
  extraWorkAmount Decimal             @default(0)
  paymentTerms    String?
  contractNo      String?
  contractDate    DateTime?
  startDate       DateTime?
  deadline        DateTime?
  status          ProjectVendorStatus @default(ACTIVE)
  notes           String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  company       Company           @relation(fields: [companyId], references: [id])
  project       Project           @relation(fields: [projectId], references: [id])
  supplier      Supplier          @relation(fields: [supplierId], references: [id])
  assignedPhase Phase?            @relation(fields: [assignedPhaseId], references: [id])
  documents     Document[]
  payables      SupplierPayable[]

  @@index([companyId, projectId, status])
  @@index([projectId, supplierId, workType])
  @@map("project_subcontractors")
}

model SupplierPayable {
  id                      String              @id @default(cuid())
  supplierId              String
  projectId               String // required — every bill belongs to a project
  phaseId                 String? // optional — bill may be project-general
  projectSupplierId       String?
  projectSubcontractorId  String?
  billNo                  String?
  billDate                DateTime
  totalAmount             Decimal
  vatPct                  Decimal?            @default(0)
  vatAmount               Decimal             @default(0)
  aitTdsPct               Decimal?            @default(0)
  aitTdsAmount            Decimal             @default(0)
  otherDeductionAmount    Decimal             @default(0)
  deductionReference      String?
  deductionNote           String?
  retentionType           RetentionType       @default(NONE)
  retentionPct            Decimal?            @default(0)
  retentionAmount         Decimal             @default(0)
  retentionReleaseDate    DateTime?
  retentionStatus         RetentionStatus     @default(NOT_APPLICABLE)
  retentionReleasedAmount Decimal             @default(0)
  serviceChargeBasis      ServiceChargeBasis?
  serviceChargeAmount     Decimal             @default(0)
  includedInBuyerDemand   Boolean             @default(false)
  netPayableAmount        Decimal?
  paidAmount              Decimal             @default(0)
  dueAmount               Decimal
  dueDate                 DateTime?
  status                  PayableStatus       @default(UNPAID)
  notes                   String?
  reversedAt              DateTime?
  reversedById            String?
  reversalReason          String?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  supplier             Supplier              @relation(fields: [supplierId], references: [id])
  project              Project               @relation(fields: [projectId], references: [id])
  phase                Phase?                @relation(fields: [phaseId], references: [id])
  projectSupplier      ProjectSupplier?      @relation(fields: [projectSupplierId], references: [id])
  projectSubcontractor ProjectSubcontractor? @relation(fields: [projectSubcontractorId], references: [id])
  payments             SupplierPayment[]
  expenses             Expense[]
  billItems            SupplierBillItem[]
  documents            Document[]

  @@index([projectSupplierId])
  @@index([projectSubcontractorId])
  @@map("supplier_payables")
}

model SupplierBillItem {
  id          String          @id @default(cuid())
  payableId   String
  description String
  category    ExpenseCategory @default(OTHER)
  quantity    Decimal?
  unit        String?
  unitPrice   Decimal?
  amount      Decimal
  createdAt   DateTime        @default(now())

  payable SupplierPayable @relation(fields: [payableId], references: [id], onDelete: Cascade)

  @@map("supplier_bill_items")
}

model SupplierPayment {
  id                 String        @id @default(cuid())
  payableId          String
  accountId          String?
  amount             Decimal
  paymentMethod      PaymentMethod @default(BANK_TRANSFER)
  chequeNo           String?
  chequeDate         DateTime?
  bankName           String?
  chequeBranchName   String?
  chequeMaturityDate DateTime?
  reference          String?
  paidAt             DateTime      @default(now())
  notes              String?
  status             String        @default("CLEARED")
  chequeStatus       String?
  reversedAt         DateTime?
  reversedById       String?
  reversalReason     String?
  createdAt          DateTime      @default(now())

  payable SupplierPayable  @relation(fields: [payableId], references: [id])
  account CashBankAccount? @relation(fields: [accountId], references: [id])

  @@map("supplier_payments")
}

model CashBankAccount {
  id                String                 @id @default(cuid())
  companyId         String
  name              String
  type              CashBankAccountType
  bankName          String?
  branchName        String?
  accountNumber     String?
  accountHolderName String?
  mobileProvider    MobileBankingProvider?
  openingBalance    Decimal                @default(0)
  currency          String                 @default("BDT")
  isDefault         Boolean                @default(false)
  isActive          Boolean                @default(true)
  notes             String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  company           Company               @relation(fields: [companyId], references: [id])
  collections       Collection[]
  expenses          Expense[]
  supplierPayments  SupplierPayment[]
  transactions      CashBankTransaction[]
  cheques           ChequeLog[]
  outgoingTransfers AccountTransfer[]     @relation("AccountTransferFrom")
  incomingTransfers AccountTransfer[]     @relation("AccountTransferTo")

  @@index([companyId, isActive])
  @@map("cash_bank_accounts")
}

model CashBankTransaction {
  id              String                    @id @default(cuid())
  companyId       String
  projectId       String?
  accountId       String
  type            CashBankTransactionType
  sourceType      CashBankSourceType
  sourceId        String?
  partyType       CashBankPartyType?
  partyId         String?
  partyName       String?
  amount          Decimal
  transactionDate DateTime
  paymentMethod   PaymentMethod             @default(CASH)
  referenceNo     String?
  description     String?
  status          CashBankTransactionStatus @default(POSTED)
  createdById     String?
  reversedAt      DateTime?
  reversedById    String?
  reversalReason  String?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  company    Company         @relation(fields: [companyId], references: [id])
  project    Project?        @relation(fields: [projectId], references: [id])
  account    CashBankAccount @relation(fields: [accountId], references: [id])
  createdBy  User?           @relation("CashBankTransactionCreatedBy", fields: [createdById], references: [id])
  reversedBy User?           @relation("CashBankTransactionReversedBy", fields: [reversedById], references: [id])

  @@index([companyId, accountId, status])
  @@index([projectId, status])
  @@index([sourceType, sourceId])
  @@map("cash_bank_transactions")
}

model ChequeLog {
  id                  String             @id @default(cuid())
  companyId           String
  projectId           String?
  accountId           String?
  chequeType          ChequeType
  chequeNo            String
  bankName            String
  branchName          String?
  chequeDate          DateTime
  maturityDate        DateTime?
  amount              Decimal
  partyType           CashBankPartyType
  partyId             String?
  partyName           String?
  sourceType          CashBankSourceType
  sourceId            String?
  status              ChequeStatus       @default(PENDING)
  clearedDate         DateTime?
  bouncedDate         DateTime?
  cancelledDate       DateTime?
  replacementChequeId String?
  notes               String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  company           Company          @relation(fields: [companyId], references: [id])
  project           Project?         @relation(fields: [projectId], references: [id])
  account           CashBankAccount? @relation(fields: [accountId], references: [id])
  replacementCheque ChequeLog?       @relation("ChequeReplacement", fields: [replacementChequeId], references: [id])
  replacedBy        ChequeLog[]      @relation("ChequeReplacement")

  @@index([companyId, status])
  @@index([projectId, status])
  @@index([sourceType, sourceId])
  @@map("cheque_logs")
}

model AccountTransfer {
  id            String                @id @default(cuid())
  companyId     String
  fromAccountId String
  toAccountId   String
  amount        Decimal
  transferDate  DateTime
  referenceNo   String?
  notes         String?
  status        AccountTransferStatus @default(POSTED)
  createdById   String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  company     Company         @relation(fields: [companyId], references: [id])
  fromAccount CashBankAccount @relation("AccountTransferFrom", fields: [fromAccountId], references: [id])
  toAccount   CashBankAccount @relation("AccountTransferTo", fields: [toAccountId], references: [id])
  createdBy   User?           @relation("AccountTransferCreatedBy", fields: [createdById], references: [id])

  @@index([companyId, status])
  @@map("account_transfers")
}

// ─────────────────────────────────────────────
// DOCUMENTS / ATTACHMENTS
// ─────────────────────────────────────────────

model Document {
  id                     String         @id @default(cuid())
  projectId              String?
  buyerId                String?
  unitId                 String?
  phaseId                String?
  expenseId              String?
  payableId              String?
  projectSupplierId      String?
  projectSubcontractorId String?
  uploadedById           String?
  title                  String?
  category               String?
  scope                  DocumentScope  @default(PROJECT)
  status                 DocumentStatus @default(DRAFT)
  sortOrder              Int            @default(0)
  fileName               String
  fileUrl                String
  fileType               String?
  fileSize               Int?
  description            String?
  uploadedAt             DateTime       @default(now())

  project              Project?              @relation(fields: [projectId], references: [id])
  buyer                Buyer?                @relation(fields: [buyerId], references: [id])
  unit                 Unit?                 @relation(fields: [unitId], references: [id])
  phase                Phase?                @relation(fields: [phaseId], references: [id])
  expense              Expense?              @relation(fields: [expenseId], references: [id])
  payable              SupplierPayable?      @relation(fields: [payableId], references: [id])
  projectSupplier      ProjectSupplier?      @relation(fields: [projectSupplierId], references: [id])
  projectSubcontractor ProjectSubcontractor? @relation(fields: [projectSubcontractorId], references: [id])
  uploadedBy           User?                 @relation("DocumentUploadedBy", fields: [uploadedById], references: [id])

  @@index([projectId, scope])
  @@index([buyerId])
  @@index([unitId])
  @@index([phaseId])
  @@index([expenseId])
  @@index([payableId])
  @@index([projectSupplierId])
  @@index([projectSubcontractorId])
  @@map("documents")
}

// ─────────────────────────────────────────────
// APPROVALS WORKFLOW
// ─────────────────────────────────────────────

model Approval {
  id          String    @id @default(cuid())
  phaseId     String?
  entityType  String // "expense" | "phase" | "demand"
  entityId    String
  status      String // "pending" | "approved" | "rejected"
  requestedBy String
  reviewedBy  String?
  reviewNote  String?
  requestedAt DateTime  @default(now())
  reviewedAt  DateTime?

  phase    Phase? @relation(fields: [phaseId], references: [id])
  reviewer User?  @relation(fields: [reviewedBy], references: [id])

  @@map("approvals")
}

// ─────────────────────────────────────────────
// PROJECT STAFF ASSIGNMENTS
// ─────────────────────────────────────────────

enum ProjectStaffRole {
  PROJECT_MANAGER // Full access within assigned project
  SITE_ENGINEER // Phases, expenses, material receipts
  SITE_SUPERVISOR // Expenses only, no approvals
  ACCOUNTS_OFFICER // Collections, expenses, suppliers, reports
  COLLECTION_OFFICER // Collections and due follow-up only
  DOCUMENT_OFFICER // Uploads and documents only
  AUDITOR // Read-only + audit lock ability
}

model ProjectStaffAssignment {
  id          String           @id @default(cuid())
  userId      String
  projectId   String
  projectRole ProjectStaffRole @default(SITE_ENGINEER)
  isActive    Boolean          @default(true)
  startDate   DateTime?
  endDate     DateTime?
  notes       String?
  assignedBy  String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@map("project_staff_assignments")
}

// ─────────────────────────────────────────────
// AUDIT LOG
// ─────────────────────────────────────────────

model AuditLog {
  id         String      @id @default(cuid())
  userId     String?
  projectId  String?
  action     AuditAction
  entityType String // "expense" | "collection" | "phase" | "buyer" etc.
  entityId   String?
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime    @default(now())

  user    User?    @relation(fields: [userId], references: [id])
  project Project? @relation(fields: [projectId], references: [id])

  @@map("audit_logs")
}
